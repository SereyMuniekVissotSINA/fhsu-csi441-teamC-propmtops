// Prompt_Ops — Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Hashed with bcryptjs. Null for users who only sign in via an OAuth provider.
  passwordHash  String?
  role          Role      @default(USER)

  accounts        Account[]
  sessions        Session[]
  prompts         Prompt[]
  memberships     Membership[]
  promptVersions  PromptVersion[]
  codeCommits     CodeCommit[]
  apiKeys         ApiKey[]
  agentRuns       AgentRun[]      @relation("AgentRunAuthor")
  snapshots       Snapshot[]
  // Restores this user asked for. Separate from `agentRuns` because asking for
  // an undo and having made the run are different people's actions.
  restoreRequests AgentRun[]      @relation("AgentRunRestorer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain models
//
// These mirror the concepts the browser-only demo already models in
// `src/lib/demo-accounts.ts` and `src/lib/demo-prompts.ts`, so the real backend
// and the offline demo describe the same product.
// ---------------------------------------------------------------------------

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

model Workspace {
  id   String @id @default(cuid())
  name String
  slug String @unique

  members   Membership[]
  prompts   Prompt[]
  apiKeys   ApiKey[]
  agentRuns AgentRun[]
  snapshots Snapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(VIEWER)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model ApiKey {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  // Only the sha256 of the key is stored; the plaintext is shown once at
  // creation and never again. `prefix` is the displayable head, e.g. "pops_a1b2".
  hashedKey   String  @unique
  prefix      String
  // Who minted the key. A request authenticated with it is attributed to this
  // user, so a prompt created from the CLI still has an author. Nullable
  // because keys minted before this column existed have no creator on record;
  // such a key can read but cannot create a prompt.
  createdById String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  usageRecords UsageRecord[]

  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([workspaceId])
  @@index([createdById])
}

model Prompt {
  id          String @id @default(cuid())
  workspaceId String
  authorId    String
  // Denormalized copy of the newest version's title so listings stay a single
  // query. Rewritten every time a version is appended.
  title       String

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author      User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  versions    PromptVersion[]
  codeCommits CodeCommit[]
  files       PromptFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, updatedAt])
  @@index([authorId])
}

// Prompts are append-only: editing a prompt writes a new version rather than
// mutating the old one, which is what makes the history view possible.
model PromptVersion {
  id       String  @id @default(cuid())
  promptId String
  title    String
  body     String
  tags     String  @default("")
  note     String  @default("")
  authorId String?

  prompt      Prompt       @relation(fields: [promptId], references: [id], onDelete: Cascade)
  author      User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  codeCommits CodeCommit[]
  usageRecords UsageRecord[]

  createdAt DateTime @default(now())

  @@index([promptId, createdAt])
  @@index([authorId])
}

// ---------------------------------------------------------------------------
// Generated code
//
// A prompt that writes code has two histories worth keeping: the prompt text
// (PromptVersion, above) and the code each run produced. A CodeCommit is the
// second one — one generation run, parsed into files, pointing back at the
// prompt version that produced it and at the commit before it.
//
// Same rule as prompts: append-only. A re-run never edits an old commit, which
// is what makes "what did this prompt used to generate?" answerable.
// ---------------------------------------------------------------------------

enum CodeFileChange {
  ADDED
  MODIFIED
  UNCHANGED
  REMOVED
}

model CodeCommit {
  id              String  @id @default(cuid())
  promptId        String
  // The prompt revision that produced this code. Nullable and SetNull: losing
  // a version must not delete the record of what it generated.
  promptVersionId String?
  // The commit this one was generated on top of. Null for the first commit.
  parentId        String?
  authorId        String?
  // Per-prompt counter, so the UI can say "c3" without counting rows.
  sequence        Int
  // Commit message. Written by the author, or derived from the diff.
  message         String  @default("")

  // Exactly what was sent and what came back, kept verbatim: the commit is
  // only reproducible if the input that produced it is stored with it.
  input        String
  output       String
  model        String
  elapsedMs    Int
  inputTokens  Int?
  outputTokens Int?
  // True when the provider stopped at the output limit, so a short file list
  // is not mistaken for the model's complete answer.
  incomplete   Boolean @default(false)

  prompt        Prompt         @relation(fields: [promptId], references: [id], onDelete: Cascade)
  promptVersion PromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  parent        CodeCommit?    @relation("CodeCommitHistory", fields: [parentId], references: [id], onDelete: SetNull)
  children      CodeCommit[]   @relation("CodeCommitHistory")
  author        User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  files         CodeFile[]

  createdAt DateTime @default(now())

  @@unique([promptId, sequence])
  @@index([promptId, createdAt])
  @@index([promptVersionId])
  @@index([parentId])
  @@index([authorId])
}

// One file at one commit. REMOVED rows carry empty contents and exist so a
// commit describes the whole generated tree, not only its additions.
model CodeFile {
  id       String         @id @default(cuid())
  commitId String
  path     String
  content  String
  // Short sha256 of the contents, for spotting an identical file across commits.
  hash     String
  language String         @default("")
  change   CodeFileChange @default(ADDED)
  added    Int            @default(0)
  removed  Int            @default(0)

  commit CodeCommit @relation(fields: [commitId], references: [id], onDelete: Cascade)

  @@unique([commitId, path])
}

// Measurements submitted by an authenticated integration, not token estimates
// inferred from prompt length. Request identity prevents retry double-counting.
model UsageRecord {
  id              String   @id @default(cuid())
  apiKeyId        String
  requestId       String
  promptVersionId String
  inputTokens     Int
  outputTokens    Int
  latencyMs       Int
  estimatedCost   Decimal  @db.Decimal(20, 8)
  currency        String   @db.VarChar(3)
  model           String
  // A caller-defined, repeatable workload (include dataset/settings identity).
  workload        String
  measuredAt      DateTime @db.Timestamptz(3)
  receivedAt      DateTime @default(now()) @db.Timestamptz(3)
  apiKey          ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  promptVersion   PromptVersion @relation(fields: [promptVersionId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, requestId])
  @@index([promptVersionId, measuredAt])
}

// Original uploads and AI revisions are immutable snapshots. Bytes live in
// PostgreSQL so they survive restarts and never enter the public asset folder.
model PromptFile {
  id           String @id @default(cuid())
  promptId     String
  name         String
  kind         String
  versionCount Int    @default(1)
  prompt       Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  versions     PromptFileVersion[]
  createdAt    DateTime @default(now())

  @@index([promptId, createdAt])
}

model PromptFileVersion {
  id              String              @id @default(cuid())
  fileId          String
  version         Int
  content         Bytes
  text            String
  mimeType        String
  size            Int
  sourceVersionId String?
  instruction     String              @default("")
  summary         String              @default("")
  model           String?
  authorId        String?
  createdAt       DateTime            @default(now())
  file            PromptFile          @relation(fields: [fileId], references: [id], onDelete: Cascade)
  source          PromptFileVersion?  @relation("FileRevisionSource", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  revisions       PromptFileVersion[] @relation("FileRevisionSource")

  @@unique([fileId, version])
  @@index([sourceVersionId])
}

// ---------------------------------------------------------------------------
// Agent runs
//
// The other half of the product from CodeCommit. There, a prompt is sent to a
// model and the files it returns become a commit. Here, an agent has already
// edited files on someone's disk, and the record is built from the filesystem:
// a baseline taken before the run, compared against the real tree afterwards.
// The agent's own account of what it changed is kept as `response`, beside the
// diff that says what actually happened.
// ---------------------------------------------------------------------------

enum AgentFileChange {
  ADDED
  MODIFIED
  REMOVED
}

// A snapshot: one line of work inside a workspace, like a branch.
//
// The workspace owns it, and the runs an agent produces are filed under it, so
// "what happened on the checkout rewrite" is a relation rather than a string
// everyone has to spell the same way. Choosing or creating a workspace
// therefore comes first: `pops snapshot` cannot name a branch until it knows
// which workspace the branch belongs to.
//
// What lives here is the record of the branch. The baseline itself — the copy
// of the working tree a push diffs against — stays in `.pops/` on the machine
// that took it: it is only ever compared against that same machine's files,
// and it has no business crossing the network.
model Snapshot {
  id          String  @id @default(cuid())
  workspaceId String
  authorId    String?
  name        String
  // What groups and filters, and what appears in a URL. The display name is
  // kept as typed beside it, so "Auth refactor" and "auth-refactor" are one
  // branch rather than two.
  slug        String

  // When a baseline was last taken for it, as the CLI reported. Null until the
  // first one: a branch can be created on the website before any machine has
  // baselined it.
  baselinedAt DateTime?
  // Retired rather than deleted. A snapshot with runs cannot be deleted, so
  // this is how a finished line of work leaves the pickers and the chips while
  // its runs stay readable.
  archivedAt  DateTime?

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  runs      AgentRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, slug])
  @@index([workspaceId, createdAt])
  @@index([authorId])
}

model AgentRun {
  id          String  @id @default(cuid())
  workspaceId String
  authorId    String?
  // Per-workspace counter, not per-category, so "r7" stays one run no matter
  // which container it is read from and a reference never becomes ambiguous.
  sequence    Int

  // The snapshot this run was measured against — the branch it belongs to.
  // Nullable only for a run pushed before snapshots became workspace-owned;
  // every push now names one.
  snapshotId String?

  // The snapshot's name as it stood when the run was pushed, kept beside the
  // relation the way `Prompt.title` copies its newest version: the log reads
  // in one query, and a run still says what the work was called at the time
  // even after the snapshot has been renamed.
  category     String    @default("")
  categorySlug String    @default("")
  // When the baseline was taken. Null when the CLI did not report it.
  baselineAt   DateTime?

  // Which agent did the work, and where. Free text: the CLI reports what it
  // was told, and this project does not define the set of agents.
  agent      String @default("")
  root       String @default("")
  prompt     String @default("")
  response   String @default("")
  // The agent's tool events as the JSON text it reported, stored verbatim
  // because their shape belongs to whichever agent produced them.
  toolEvents String @default("[]")

  // The restore handshake. A web page cannot write to someone's working
  // directory, so undoing a run is two steps with the operator in the middle:
  // the website stamps a request here, and `pops restore` on the machine that
  // owns the files picks it up, applies it, and stamps `restoredAt`. None of
  // this edits the run — the log still says what the agent did after an undo.
  restoreRequestedAt   DateTime?
  restoreRequestedById String?
  restoredAt           DateTime?

  workspace          Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: a snapshot with runs under it cannot be deleted,
  // because those runs are the record of what an agent did. Archiving is how a
  // branch is retired — see `Snapshot.archivedAt`.
  snapshot           Snapshot?      @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  author             User?          @relation("AgentRunAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  restoreRequestedBy User?          @relation("AgentRunRestorer", fields: [restoreRequestedById], references: [id], onDelete: SetNull)
  files              AgentRunFile[]

  createdAt DateTime @default(now())

  @@unique([workspaceId, sequence])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, categorySlug, createdAt])
  @@index([snapshotId, createdAt])
  @@index([authorId])
  @@index([restoreRequestedById])
}

// One file the run touched, with both sides of it. There is no UNCHANGED:
// a run records changes, and a file nobody touched is not part of the record.
// `before` is what a restore writes back to disk, which is why it is stored
// rather than derived.
model AgentRunFile {
  id         String          @id @default(cuid())
  runId      String
  path       String
  before     String
  after      String
  beforeHash String
  afterHash  String
  language   String          @default("")
  change     AgentFileChange
  added      Int             @default(0)
  removed    Int             @default(0)

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, path])
}

// Prompt_Ops — Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Hashed with bcryptjs. Null for users who only sign in via an OAuth provider.
  passwordHash  String?
  role          Role      @default(USER)

  accounts       Account[]
  sessions       Session[]
  prompts        Prompt[]
  memberships    Membership[]
  promptVersions PromptVersion[]
  codeCommits    CodeCommit[]
  apiKeys        ApiKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain models
//
// These mirror the concepts the browser-only demo already models in
// `src/lib/demo-accounts.ts` and `src/lib/demo-prompts.ts`, so the real backend
// and the offline demo describe the same product.
// ---------------------------------------------------------------------------

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

model Workspace {
  id   String @id @default(cuid())
  name String
  slug String @unique

  members Membership[]
  prompts Prompt[]
  apiKeys ApiKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(VIEWER)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model ApiKey {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  // Only the sha256 of the key is stored; the plaintext is shown once at
  // creation and never again. `prefix` is the displayable head, e.g. "pops_a1b2".
  hashedKey   String  @unique
  prefix      String
  // Who minted the key. A request authenticated with it is attributed to this
  // user, so a prompt created from the CLI still has an author. Nullable
  // because keys minted before this column existed have no creator on record;
  // such a key can read but cannot create a prompt.
  createdById String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([workspaceId])
  @@index([createdById])
}

model Prompt {
  id          String @id @default(cuid())
  workspaceId String
  authorId    String
  // Denormalized copy of the newest version's title so listings stay a single
  // query. Rewritten every time a version is appended.
  title       String

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author      User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  versions    PromptVersion[]
  codeCommits CodeCommit[]
  files       PromptFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, updatedAt])
  @@index([authorId])
}

// Prompts are append-only: editing a prompt writes a new version rather than
// mutating the old one, which is what makes the history view possible.
model PromptVersion {
  id       String  @id @default(cuid())
  promptId String
  title    String
  body     String
  tags     String  @default("")
  note     String  @default("")
  authorId String?

  prompt      Prompt       @relation(fields: [promptId], references: [id], onDelete: Cascade)
  author      User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  codeCommits CodeCommit[]

  createdAt DateTime @default(now())

  @@index([promptId, createdAt])
  @@index([authorId])
}

// ---------------------------------------------------------------------------
// Generated code
//
// A prompt that writes code has two histories worth keeping: the prompt text
// (PromptVersion, above) and the code each run produced. A CodeCommit is the
// second one — one generation run, parsed into files, pointing back at the
// prompt version that produced it and at the commit before it.
//
// Same rule as prompts: append-only. A re-run never edits an old commit, which
// is what makes "what did this prompt used to generate?" answerable.
// ---------------------------------------------------------------------------

enum CodeFileChange {
  ADDED
  MODIFIED
  UNCHANGED
  REMOVED
}

model CodeCommit {
  id              String  @id @default(cuid())
  promptId        String
  // The prompt revision that produced this code. Nullable and SetNull: losing
  // a version must not delete the record of what it generated.
  promptVersionId String?
  // The commit this one was generated on top of. Null for the first commit.
  parentId        String?
  authorId        String?
  // Per-prompt counter, so the UI can say "c3" without counting rows.
  sequence        Int
  // Commit message. Written by the author, or derived from the diff.
  message         String  @default("")

  // Exactly what was sent and what came back, kept verbatim: the commit is
  // only reproducible if the input that produced it is stored with it.
  input        String
  output       String
  model        String
  elapsedMs    Int
  inputTokens  Int?
  outputTokens Int?
  // True when the provider stopped at the output limit, so a short file list
  // is not mistaken for the model's complete answer.
  incomplete   Boolean @default(false)

  prompt        Prompt         @relation(fields: [promptId], references: [id], onDelete: Cascade)
  promptVersion PromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  parent        CodeCommit?    @relation("CodeCommitHistory", fields: [parentId], references: [id], onDelete: SetNull)
  children      CodeCommit[]   @relation("CodeCommitHistory")
  author        User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  files         CodeFile[]

  createdAt DateTime @default(now())

  @@unique([promptId, sequence])
  @@index([promptId, createdAt])
  @@index([promptVersionId])
  @@index([parentId])
  @@index([authorId])
}

// One file at one commit. REMOVED rows carry empty contents and exist so a
// commit describes the whole generated tree, not only its additions.
model CodeFile {
  id       String         @id @default(cuid())
  commitId String
  path     String
  content  String
  // Short sha256 of the contents, for spotting an identical file across commits.
  hash     String
  language String         @default("")
  change   CodeFileChange @default(ADDED)
  added    Int            @default(0)
  removed  Int            @default(0)

  commit CodeCommit @relation(fields: [commitId], references: [id], onDelete: Cascade)

  @@unique([commitId, path])
}

// Original uploads and AI revisions are immutable snapshots. Bytes live in
// PostgreSQL so they survive restarts and never enter the public asset folder.
model PromptFile {
  id           String @id @default(cuid())
  promptId     String
  name         String
  kind         String
  versionCount Int    @default(1)
  prompt       Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  versions     PromptFileVersion[]
  createdAt    DateTime @default(now())

  @@index([promptId, createdAt])
}

model PromptFileVersion {
  id              String @id @default(cuid())
  fileId          String
  version         Int
  content         Bytes
  text            String
  mimeType        String
  size            Int
  sourceVersionId String?
  instruction     String @default("")
  summary         String @default("")
  model           String?
  authorId        String?
  createdAt       DateTime @default(now())
  file            PromptFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  source          PromptFileVersion? @relation("FileRevisionSource", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  revisions       PromptFileVersion[] @relation("FileRevisionSource")

  @@unique([fileId, version])
  @@index([sourceVersionId])
}

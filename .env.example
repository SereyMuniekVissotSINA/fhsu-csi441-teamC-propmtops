# Copy to `.env` and fill in. `.env` is gitignored; this file is not.

# PostgreSQL connection string from your cloud database provider. Keep it
# server-only; never prefix it with NEXT_PUBLIC_. URL-encode special characters
# in the username/password. Most cloud providers require TLS.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# If your provider gives you a separate direct (non-pooled) URL, uncomment it.
# Prisma CLI migrations use this while the running app uses DATABASE_URL.
# DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"

# Generate with: bunx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Optional: development-only OpenAI testing in the authenticated prompt editor.
# Use an API key and a Responses-compatible model ID available to your project.
# OPENAI_API_KEY=""
# OPENAI_MODEL=""

# Local 9Router (takes precedence over direct OpenAI when set).
# LLM_BASE_URL="http://localhost:20128/v1"
# LLM_MODEL="openrouter/stepfun/step-3.5-flash:free"
# LLM_API_KEY=""

# Only needed when the app is not served from http://localhost:3000
# AUTH_URL="http://localhost:3000"

# --- OAuth (optional) ---------------------------------------------------
# Each provider needs BOTH values or it is not offered on the login page.
# GitHub:  https://github.com/settings/developers
#          callback: http://localhost:3000/api/auth/callback/github
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
#
# Google:  https://console.cloud.google.com/apis/credentials
#          callback: http://localhost:3000/api/auth/callback/google
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

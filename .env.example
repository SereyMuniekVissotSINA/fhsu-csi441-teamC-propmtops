# Copy to `.env` and fill in. `.env` is gitignored; this file is not.

# SQLite lives in the repo during development.
DATABASE_URL="file:./dev.db"

# Generate with: bunx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Only needed when the app is not served from http://localhost:3000
# AUTH_URL="http://localhost:3000"

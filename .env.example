# Copy to `.env` and fill in. `.env` is gitignored; this file is not.

# PostgreSQL connection string from your cloud database provider. Keep it
# server-only; never prefix it with NEXT_PUBLIC_. URL-encode special characters
# in the username/password. Most cloud providers require TLS.
#
# Prefer `sslmode=verify-full`. Our pg driver currently treats `require` as an
# alias for it, but warns on every run because pg v9 will downgrade `require`
# to weaker verification. Spelling it out keeps today's behaviour and silences
# the warning. Providers hand you `require`; swapping it is safe.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full"
# If your provider gives you a separate direct (non-pooled) URL, uncomment it.
# Prisma CLI migrations use this while the running app uses DATABASE_URL.
# DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=verify-full"

# Generate with: bunx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Optional: AI testing in the prompt editor, through a local 9Router instance
# (or any OpenAI-compatible server). All three are needed together.
#
# LLM_API_KEY is the key 9Router issues you — keep your upstream OpenRouter key
# inside 9Router itself, never here. LLM_MODEL must be an id from the server's
# own `GET /v1/models` list.
# LLM_BASE_URL="http://localhost:20128/v1"
# LLM_MODEL="openrouter/nvidia/nemotron-3-super-120b-a12b:free"
# LLM_API_KEY=""

# Set to true to allow authenticated workspace editors to test AI in production.
# Otherwise AI testing is development-only.
# AI_TESTING_ENABLED="false"

# Only needed when the app is not served from http://localhost:3000
# AUTH_URL="http://localhost:3000"

# --- OAuth (optional) ---------------------------------------------------
# Each provider needs BOTH values or it is not offered on the login page.
# GitHub:  https://github.com/settings/developers
#          callback: http://localhost:3000/api/auth/callback/github
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
#
# Google:  https://console.cloud.google.com/apis/credentials
#          callback: http://localhost:3000/api/auth/callback/google
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

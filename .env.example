# Copy to `.env` and fill in. `.env` is gitignored; this file is not.

# SQLite lives in the repo during development.
DATABASE_URL="file:./dev.db"

# Generate with: bunx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Only needed when the app is not served from http://localhost:3000
# AUTH_URL="http://localhost:3000"

# --- OAuth (optional) ---------------------------------------------------
# Each provider needs BOTH values or it is not offered on the login page.
# GitHub:  https://github.com/settings/developers
#          callback: http://localhost:3000/api/auth/callback/github
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
#
# Google:  https://console.cloud.google.com/apis/credentials
#          callback: http://localhost:3000/api/auth/callback/google
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
